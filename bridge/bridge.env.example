# Arena Bridge — пример конфигурации
# Скопируй этот файл как bridge.env рядом с arena-bridge.exe (или ./arena-bridge на Mac)
# и заполни значения (токен и URL выдаёт администратор).

# ── Обязательные ────────────────────────────────────────────────────────────

# Полный путь к папке WoW (папка содержит подпапку Logs/)
# Windows:
WOW_INSTALL_PATH=C:\Program Files (x86)\World of Warcraft\_anniversary_
# macOS (раскомментировать если нужно):
# WOW_INSTALL_PATH=/Applications/World of Warcraft/_anniversary_

# URL backend'а (выдаётся администратором)
BACKEND_URL=https://coach.example.com

# Bearer-токен — общий BRIDGE_BEARER_TOKEN, его выдаёт администратор
# (это НЕ per-player токен; /access add токен не выдаёт)
BRIDGE_BEARER_TOKEN=paste-your-token-here

# Точное имя WoW-персонажа (регистр важен — как в игре)
BRIDGE_PLAYER_NAME=YourCharacterName

# ── Опциональные ─────────────────────────────────────────────────────────────

# Наш состав (fallback для таргетированных советов, если аддон < 0.2.0
# и не шлёт союзников). Формат: class+class, напр. rogue+mage
# BRIDGE_OUR_COMP=rogue+mage

# Интервал опроса chat-лога в секундах (default: 0.5)
# BRIDGE_POLL_INTERVAL=0.5

# Уровень логирования: DEBUG / INFO / WARNING / ERROR (default: INFO)
# LOG_LEVEL=INFO
